## Multi-stage: build the app, then create a minimal runtime container
## that can run on any Linux host with X11 or Wayland.
##
## Usage:
##   docker build -f Dockerfile.run -t asciidiff .
##   ./asciidiff-container.sh [/path/to/repo]

# --- Build stage ---
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    wget \
    file \
    libwebkit2gtk-4.1-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libssl-dev \
    pkg-config \
    patchelf \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN wget -qO- https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install Node.js 20
RUN wget -qO- https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

RUN cd frontend && npm ci && npx tauri build --bundles none

# --- Runtime stage ---
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Runtime dependencies only (no -dev packages)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libwebkit2gtk-4.1-0 \
    libgtk-3-0 \
    libayatana-appindicator3-1 \
    librsvg2-2 \
    libssl3 \
    dbus-x11 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Copy the built binary
COPY --from=builder /app/frontend/src-tauri/target/release/asciidiff /usr/local/bin/asciidiff

# Run as non-root user
RUN useradd -m -s /bin/bash appuser
USER appuser
WORKDIR /home/appuser

ENV WEBKIT_DISABLE_DMABUF_RENDERER=1

ENTRYPOINT ["/usr/local/bin/asciidiff"]
