FROM registry.opensuse.org/opensuse/leap:15.5

# openSUSE Leap 15.5 = glibc 2.31, glib 2.70 — oldest viable combo for Tauri v2.
# glib >= 2.70 is required at build time; glibc 2.31 gives broad runtime compat.
# The AppImage bundles everything except glibc, so the result runs on any Linux
# with glibc >= 2.31 (Debian 11+, Ubuntu 20.04+, Fedora 34+, RHEL/Alma 9+).

RUN zypper -n refresh && zypper -n install -y \
        gcc \
        gcc-c++ \
        make \
        curl \
        wget \
        file \
        pkg-config \
        patchelf \
        libopenssl-devel \
        webkit2gtk3-devel \
        gtk3-devel \
        libayatana-appindicator3-devel \
        librsvg-devel \
        git \
        tar \
        xz \
        && zypper clean -a

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install Node.js 20 (official binary — NodeSource doesn't support openSUSE)
RUN curl -fsSL https://nodejs.org/dist/v20.19.2/node-v20.19.2-linux-x64.tar.xz \
    | tar -xJ -C /usr/local --strip-components=1

WORKDIR /app
