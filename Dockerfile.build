FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Ubuntu 22.04 = glibc 2.35, glib 2.72 — minimum viable for Tauri v2
# Note: RHEL 9 has glibc 2.34 but Tauri v2 requires glib >= 2.70 at build time.
# glibc 2.35 is compatible with RHEL 9.1+ (which ships glibc 2.34 but the
# AppImage bundles everything except glibc — test on target before distributing).

RUN apt-get update && apt-get install -y \
    build-essential \
    wget \
    file \
    libwebkit2gtk-4.1-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libssl-dev \
    pkg-config \
    patchelf \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN wget -qO- https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install Node.js 20
RUN wget -qO- https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
